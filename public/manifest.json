{
  "manifest_version": 3,
  "name": "Relay - Screen Recorder",
  "description": "Record your screen, camera, and microphone. Organize videos, playlists, meetings, and workspace insights locally.",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Relay recording studio",
    "default_icon": {
      "16": "icons/relay-16.png",
      "32": "icons/relay-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "icons": {
    "16": "icons/relay-16.png",
    "32": "icons/relay-32.png",
    "48": "icons/relay-48.png",
    "128": "icons/relay-128.png"
  }
}
